def check_reeval_unchanged() -> str:
    """The wrapped module must be the registered, byte-identical v4int/reeval.py (the shim's checks assume its code)."""
    got = R._sha(Path(R.__file__))
    if got != REEVAL_SHA256:
        _refuse(f"v4int/reeval.py sha256 {got} is not the registered {REEVAL_SHA256}: the P2 shim refuses to wrap it")
    return got


