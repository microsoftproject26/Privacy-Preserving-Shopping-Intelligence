{
  "allowed_event_types": [
    "view",
    "cart",
    "purchase"
  ],
  "batch_size": 500000,
  "compression": "zstd",
  "compression_level": 6,
  "config_version": 1,
  "contract": "ProcessedRawParquet v1",
  "deterministic_tie_key": [
    "event_time",
    "source_row_number"
  ],
  "fail_if_any_rejected": true,
  "input_csv": "../Dataset/2019-Oct.csv/2019-Oct.csv",
  "input_manifest": "config/dataset_manifest.v1.json",
  "nullable_fields": [
    "category_code",
    "brand",
    "user_session"
  ],
  "output_directory": "artifacts/full-run",
  "price_policy": {
    "allow_negative": false,
    "allow_zero": true
  },
  "rejection_priority": [
    "CSV_PARSE_ERROR",
    "MISSING_REQUIRED_ID",
    "INVALID_TIMESTAMP",
    "UNKNOWN_EVENT_TYPE",
    "INVALID_PRICE"
  ],
  "required_non_null_ids": [
    "product_id",
    "category_id",
    "user_id"
  ],
  "statistics": true,
  "verify_expected_source_identity": true,
  "verify_input_sha256": true,
  "workspace": ".."
}
