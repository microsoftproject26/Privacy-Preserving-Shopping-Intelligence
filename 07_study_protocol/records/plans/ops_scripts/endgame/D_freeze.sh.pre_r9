#!/bin/bash
# D_freeze.sh — builds the CANDIDATE company/gates/ANA_SCRIPT_FREEZE.json on the server (review §1 Phase D / D1;
# MASTER_PLAN 1.7; ANA-05 step 4; FIX-REEVAL-06O; 06P P7). FINAL r7 form (OPS-ENDGAME-2), NOT RUN. Reads paths / statuses / hashes only:
# no RESULT_ROWS, metrics.jsonl, evals/ or best_metric is opened. The candidate becomes the freeze only by the LOCAL
# O_EXCL copy + DL row + sha-checked upload to $V/company/gates/ANA_SCRIPT_FREEZE.json (README §3 D).
# Predecessors: ok/B_REAL.ok (D3 panels) + ok/B2_REAL.ok (C_FULL s2027) + the A6 inventory below (all runs done).
# Usage: D_freeze.sh <contrasts_v4_file_sha256 as registered in the DL row> (= f1769f0b…, DL 336; refused otherwise)
# Also refuses while a smoke-named dir sits in REEVAL_A40 / FL_T / DEV (the index would refuse the whole build; run
# P_park_smoke_dirs.sh first — an Ops decision, README §4 item 6).
# Output: $R/ANA/freeze_<tag>/ANA_SCRIPT_FREEZE.candidate.json (O_EXCL, a-w) + ok/D_<tag>.ok.
CSHA=$1
LOG=/home/jovyan/ahmedabdelhamed01/Privacy-Preserving-Shopping-Intelligence/.local_ai/ppsi_v4/runs_ds3/queues/endgame_D.log
source /home/jovyan/ahmedabdelhamed01/Privacy-Preserving-Shopping-Intelligence/.local_ai/ppsi_v4/runs_ds3/queues/_common_code_ds3r7.sh
source $Q/endgame/_endgame_lib.sh
[[ "$CSHA" =~ ^[0-9a-f]{64}$ ]] || eg_refuse "usage: D_freeze.sh <ANA_CONTRASTS_v4.json file sha256 from its DL row>"
[ "$CSHA" = "$CONTRASTS_SHA" ] || eg_refuse "contrasts sha $CSHA is not the DL 336 registration $CONTRASTS_SHA"
need $OK/B_REAL.ok; need $OK/B2_REAL.ok; once $OK/D_$ANA_TAG.ok
# FIX-4 (Fable gate 10-03): the smoke dirs were parked by P (DL 356); the freeze binds the manifest (sha ec779fd4ea9dbe51…)
need $OK/P_PARK.ok; PARKM=$R/_PARKED_SMOKE/PARK_MANIFEST.json; need $PARKM
[[ "$(sha $PARKM)" == ec779fd4ea9dbe51* ]] || eg_refuse "PARK_MANIFEST.json sha is not the DL 356 ec779fd4ea9dbe51…"
# FIX-5: the frozen descriptive metric-table extractor (registration REG_DESCRIPTIVE_METRIC_TABLE.md, DL row before D)
MTAB=$EG/metric_table.py; need $MTAB
[ -n "${MT_REG_DL:-}" ] || eg_refuse "set MT_REG_DL=<DL row number registering the descriptive metric table> (FIX-5)"
need $CONTRASTS; [ "$(sha $CONTRASTS)" = "$CSHA" ] || eg_refuse "server ANA_CONTRASTS_v4.json sha != the DL-registered $CSHA"
[ ! -e $FREEZE ] || eg_refuse "$FREEZE already exists (a freeze is never rebuilt; a new freeze = a new tree + DL row)"
source $Q/endgame/_endgame_ana_args.sh
SMK=$(smoke_dirs "$R/REEVAL_A40" "$R/FL_T" "$R/DEV"); [ -z "$SMK" ] || eg_refuse "smoke-named dirs in an indexed root (index check_smoke_name refuses the build): $(echo $SMK)"
FD=$ANA/freeze_$ANA_TAG; mkdir -p $FD; CAND=$FD/ANA_SCRIPT_FREEZE.candidate.json; once $CAND
step "PHASE_START D freeze tree=$CR"
# 06L-C C12 / 06P P7: the --claims-only output regenerated under v4 (no block, no value)
CL=$FD/claims_v4; once $CL
ejob EGD_CLAIMS_V4 $PY -B $TOOLS/retention_report.py --claims-only --contrasts $CONTRASTS --code-root $CR --out $CL
ana_cmd_text > $FD/SECTION9_COMMANDS.txt
export V R CR TOOLS CONTRASTS CSHA PIN CAND CL FD PARKM MTAB MT_REG_DL
export ANA_RECORDS_LIST="$(printf '%s\n' "${ANA_RECORDS[@]}")" ANA_ONNX_ON="${#ANA_ONNX[@]}" ANA_TRUNC_ON="${#ANA_TRUNC[@]}" ANA_ONNX_DIR
$PY -B - <<'PY' >> "$LOG" 2>&1 || { step "LANE_STOP freeze candidate REFUSED (see $LOG)"; exit 99; }
import hashlib, importlib.util, json, os, sys
from pathlib import Path
E = os.environ; V, R, CR, TOOLS = (Path(E[k]) for k in ("V", "R", "CR", "TOOLS"))
def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def j(p): return json.loads(Path(p).read_text(encoding="utf-8"))
def refuse(m): print("REFUSED:", m); sys.exit(1)
def status(d):
    p = d / "RUN_SUMMARY.json"
    return j(p).get("status") if p.is_file() else "NO_RUN_SUMMARY"
# ---- A6 inventory (paths + status only) -------------------------------------------------------------------------
STOPPED = ("FP_s2026", "FP_s2027", "FA_1024_s2026")                       # 06N N4 / DL 317 D2: never indexed
MARKER = "STOPPED_REALLOCATED.json"                                        # Fable audit M5 (DL 331): existence only
inv, bad = {}, []
for n in STOPPED:                                                         # MEASURED 10-02: all three carry the marker
    if not (R / "FL_T" / n / MARKER).is_file(): bad.append(f"FL_T/{n} lacks its {MARKER} marker (M5)")
for d in sorted((R / "FL_T").iterdir()):
    if not d.is_dir(): continue
    s = status(d); inv[f"FL_T/{d.name}"] = s
    if d.name in STOPPED or (d / MARKER).is_file(): continue                 # the index excludes both (L419)
    if d.name.startswith("S_CAL"): continue                               # excluded by the index (DONE_S_CAL rule)
    if s != "DONE_MAIN": bad.append(f"FL_T/{d.name}={s}")
WANT_FL = ["FA_s2026", "FA_s2027"] + [f"N33_{a}_s{s}" for a in ("FP", "PF", "FA_Q8", "FA_1024", "DP8") for s in (2026, 2027)] \
    + ["N33_DP1_s2026", "DP1_WARM_FROZEN_s2026"] + [f"{a}_s{s}" for a in ("FA_WARM", "FA_WARM_FROZEN", "FP_WARM_FROZEN",
       "PF_WARM_FROZEN", "FA_Q8_WARM_FROZEN", "FA_1024_WARM_FROZEN", "DP8_FROZEN") for s in (2026, 2027)]
bad += [f"FL_T/{n} missing" for n in WANT_FL if f"FL_T/{n}" not in inv]
WANT_DEV = [f"{a}_s{s}" for a in ("LO", "FT_C", "FT_PRE", "FT_FA", "FT_FA_WARM", "FT_FA_WARM_FROZEN") for s in (2026, 2027)] \
    + ["FT_C_UNSEEN_HOLDOUT_s2026", "LO_UNSEEN_HOLDOUT_s2026"]
for d in sorted((R / "DEV").iterdir()):
    if d.is_dir(): inv[f"DEV/{d.name}"] = status(d)
# Q9 RESOLVED: launch_device writes RUN_SUMMARY status DONE (launch_device L659) and the index requires DONE (L523)
bad += [f"DEV/{n} is {inv.get(f'DEV/{n}', 'MISSING')}, not DONE" for n in WANT_DEV if inv.get(f"DEV/{n}") != "DONE"]
for d in sorted((R / "REEVAL_A40").iterdir()):
    if d.is_dir():
        rr = d / "REEVAL_RECORD.json"; inv[f"REEVAL_A40/{d.name}"] = j(rr).get("status") if rr.is_file() else "NO_RECORD"
if bad: refuse("A6 inventory: " + "; ".join(bad))
code_tree = {}
for k in inv:
    if k.startswith(("FL_T/", "DEV/")):
        L = sorted((R / k).glob("LAUNCH_*.json"))
        if L:
            x = j(L[-1]); code_tree[k] = {f: x.get(f) for f in ("code_tree", "code_root", "fl_code_sha256", "launch_code_sha256") if f in x}
# ---- tools / code identities ------------------------------------------------------------------------------------
tm = j(R / "deploy_r8/TOOLS_MANIFEST.json")["files"]; sm = j(R / "deploy_r7/SYNC_MANIFEST.json")   # DL 390: tools_r8 (ANA-07); code tree stays r7
tools = {}
for rel in ("tools/retention_report.py", "tools/ana_block_index.py", "tools/test_exposure_register.py"):
    s = sha(V / rel)
    if tm.get(rel) != s: refuse(f"{rel} on the server is not the r8 pack ({s[:12]})")
    tools[rel] = s
tools["tools/g2_run.py"] = sha(V / "tools/g2_run.py")
tools[str(Path(E["MTAB"]).relative_to(V))] = sha(E["MTAB"])          # FIX-5: freeze_check re-hashes every scripts entry
for rel, h in sm["files"].items():                                        # the deployed tree is still the pack
    if sha(V / "code_ds3r7" / rel[len("code/"):]) != h: refuse(f"code_ds3r7/{rel} differs from SYNC_MANIFEST")
sys.path.insert(0, str(CR))
import v4eval
ev = v4eval.evaluator_code_sha256()
if not ev.startswith("61b64e61"): refuse(f"evaluator_code_sha256 {ev[:12]} is not 61b64e61")
spec = importlib.util.spec_from_file_location("_rr_freeze", str(TOOLS / "retention_report.py"))
rr = importlib.util.module_from_spec(spec); sys.modules[spec.name] = rr; spec.loader.exec_module(rr)   # DL 387: dataclasses need the module registered
lib = rr.bind(CR).files_sha256                                            # exactly the map the report prints
from v4int.launch_fl import fl_code_sha256
trees = {"code_ds3r7": {"aggregate_sha256": sm["aggregate_sha256"], "tar_sha256": sm["tar_sha256"]}}
for n, dd in (("code_ds3r2", "deploy_r2"), ("code_ds3r3", "deploy_r3"), ("code_ds3r4", "deploy_r4"), ("code_ds3r5", "deploy_r5"),
              ("code_ds3r6", "deploy_r6")):
    p = R / dd / "SYNC_MANIFEST.json"
    trees[n] = {"aggregate_sha256": j(p).get("aggregate_sha256")} if p.is_file() else \
        "NO_SYNC_MANIFEST on the server (MEASURED 10-02: deploy_r3 has none; the runs' LAUNCH code identities are listed)"
# ---- contrasts v4 + records ---------------------------------------------------------------------------------------
c = j(E["CONTRASTS"])
if c.get("format") != "PPSI_V4_ANA_CONTRASTS_4" or c.get("draft") is not False: refuse("v4 contrasts are not a final (draft false) v4 file")
v3p = V / "company/gates/ANA_CONTRASTS_v3.json"
REG = {"FL_WARM_SELECTION_S7.json": "d67a0a85", "FL_WARM_SELECTION_S8.json": "8b79d305", "S_RECORD_WARM_FROZEN.json": "2e47ba39",
       "S_RECORD.json": "7ab91eb2", "SELECTION_FT_C.json": "e47965d2", "EVAL_DEVICE_PIN_A40.json": "db744ca3",
       "FL_TUNING_SELECTION.json": "9bca186e", "SELECTION_FT_FA.json": "a645edaf"}   # DL-registered prefixes (file or
#   self sha): S7 / S8 / S_RECORD_WARM_FROZEN DL 300 / 310 / 331; SELECTION_FT_FA DL 351; tuning DL 279; pin db744ca3
recs = {}
for p in E["ANA_RECORDS_LIST"].split("\n") + [E["PIN"], str(V / "contracts/fl/FL_TUNING_SELECTION.json")]:
    p = Path(p); d = j(p); fs = sha(p); ss = d.get("self_sha256") if isinstance(d, dict) else None
    want = REG.get(p.name)
    if want and not (fs.startswith(want) or (ss or "").startswith(want)): refuse(f"{p.name}: neither file nor self sha starts {want}")
    recs[str(p.relative_to(V)) if str(p).startswith(str(V)) else str(p)] = {"file_sha256": fs, "self_sha256": ss}
cl = Path(E["CL"]); claims = {f.name: sha(f) for f in sorted(cl.iterdir()) if f.is_file()}
cmd = (Path(E["FD"]) / "SECTION9_COMMANDS.txt").read_text()
k16 = E["ANA_ONNX_ON"] != "0"; trunc = E["ANA_TRUNC_ON"] != "0"
# FIX-3 (DL 368): pin the K16 pass-1 artifacts (hashed, never parsed); pass 2 (latency only) must assert these bytes
K16_LAT = ("PASS2_PENDING — the device latency is LATENCY_PASS2.json (DL 368); pass-1 latency is loaded-host, "
           "never the device number")
k16art = None
if k16:
    od = Path(E["ANA_ONNX_DIR"]); k16art = {}
    for n in ("BENCH_RESULT.json", "rows.meta.json", "rows.npz", "model_fp32.onnx", "model_int8.onnx"):
        if not (od / n).is_file(): refuse(f"K16 pass-1 artifact {od / n} missing")
    for f in sorted(q for q in od.rglob("*") if q.is_file() and q.name not in ("LATENCY_PASS2.json", "PASS2_HOST_LOAD.json")):
        k16art[str(f.relative_to(R))] = sha(f)
    hl = R / "ONNX_R7" / "PASS1_HOST_LOAD.json"
    if not hl.is_file(): refuse(f"{hl} missing (DL 369: the pass-1 host load record)")
    k16art[str(hl.relative_to(R))] = sha(hl)
    if (R / "ONNX_R7" / "BENCH_RESULT.json").is_file() and od.name != "ONNX_R7":
        refuse("ONNX_R7 holds a BENCH_RESULT.json beside the fallback result (Fable note i)")
NOT_RUN = ["DP_OPT_SENS (06H §3; superseded by the 06N re-allocation, DL 317 D3)", "FA_X2 (S5)",
           "device panels on SPARSE_PANEL / HEAVY_PANEL / TRUE_COLD (6.6; only FT_C + LO on UNSEEN_HOLDOUT s2026 ran, K9b)",
           "TRUNC Study B", "FA_WARM panel rows (optional in review B3; not registered by DL 317)",
           "no 'events to parity' sentence (TRUNC)",
           "GRU_D128 (06L-C C11) and the 06L-C D1 contest single 02B_GRU: v4int/reeval.py r7 accepts --variant SASREC_D256_B3 / "
           "SASREC_D64_B2 only (MEASURED --help), so no GRU checkpoint can be re-evaluated on the A40 class; the 02B_SASREC "
           "contest single IS the C_BIG s2026 / s2027 MAIN_TEST reeval of the lock",
           "EVENT_SIZE (06L-C C8): no registered per-event size; the raw-event bytes level is reported NOT_REGISTERED"]
if not trunc: NOT_RUN.append("TRUNC T41 / Study A")
if not k16: NOT_RUN.append("C_SMALL INT8 (K16): no BENCH_RESULT in ONNX_R7 / ONNX_R7_U16384 (laneD3_INT8_r7, DL 343) — a MUST-tier "
                           "item (06D §8): this declaration needs its own Ops / Fable DL decision before E")
doc = {
 "document": "ANA_SCRIPT_FREEZE", "format": "PPSI_V4_ANA_SCRIPT_FREEZE_1", "status": "CANDIDATE (server-built; becomes the freeze only by the local O_EXCL copy + DL row)",
 "authority": "MASTER_PLAN_V5 1.7; FABLE_ENDGAME_REVIEW_20261001 §1 D1 / §5; PREG1_AMENDMENT_06P P7; DL 315-321",
 "scripts": tools, "retention_report_sha256": tools["tools/retention_report.py"],
 "reeval_sha256": sha(CR / "v4int/reeval.py"), "launch_fl_sha256": sha(CR / "v4int/launch_fl.py"),
 "launch_device_sha256": sha(CR / "v4int/launch_device.py"), "fl_code_sha256": fl_code_sha256(),
 "library_files_sha256": lib, "evaluator_code_sha256": ev, "code_root": str(CR), "code_trees": trees,
 "contrasts": {"path": "company/gates/ANA_CONTRASTS_v4.json", "file_sha256": E["CSHA"], "self_sha256": c.get("self_sha256"),
               "amendment_06P_file_sha256": c.get("amendment_06P_file_sha256"),
               "lineage_v3_file_sha256": sha(v3p) if v3p.is_file() else "a3d1456d… (registered; v3 file not on the server)",
               "hierarchy": c.get("hierarchy"), "holm_family": c.get("holm_family"), "registered_seeds": c.get("registered_seeds"),
               "confirmatory_rule_map": c.get("confirmatory_rule_map"), "seed_cuts": [], "allow_single_seed": []},
 "fa_warm_star": "FA_WARM* = FA_WARM_FROZEN (S8) by 06N N2 on the CALIB selections (DL 292); S7 rows DESCRIPTIVE (06P P2)",
 "claims_only_v4": claims, "records": recs,
 "section9_commands": cmd, "section9_commands_sha256": hashlib.sha256(cmd.encode()).hexdigest(),
 "k16_included": k16, "k16_onnx_dir": E.get("ANA_ONNX_DIR") or None,
 "k16_first_users": 16384 if (E.get("ANA_ONNX_DIR") or "").endswith("_U16384") else None,   # MASTER_PLAN 8.2 fallback
 "k16_pass1_artifacts": k16art, "k16_latency": K16_LAT,
 "trunc_included": trunc, "declared_not_run": NOT_RUN,
 "parked_smoke": {"manifest": str(Path(E["PARKM"]).relative_to(V)), "manifest_sha256": sha(E["PARKM"]),
                  "dirs": sorted(x["to"].split("/runs_ds3/")[1] for x in json.loads(Path(E["PARKM"]).read_text())),
                  "label": "SMOKE_NOT_EVIDENCE, parked out of the indexed roots by P_park_smoke_dirs.sh (DL 356); never evidence"},
 "descriptive_metric_table": {"script": str(Path(E["MTAB"]).relative_to(V)), "script_sha256": sha(E["MTAB"]),
                  "registration": f"DL {E['MT_REG_DL']} (company/plans/ops_scripts/endgame/REG_DESCRIPTIVE_METRIC_TABLE.md)",
                  "runs": "F (block_val, right after the read) and H analysis (block_test); values copied verbatim, no new computation",
                  "label": "DESCRIPTIVE beside the primary macro MRR@20 (06P); HR / NDCG / MRR @ 1, 5, 10, 20; micro + macro; E2E + RANKABLE"},
 "exclusions_by_name": ["FL_T/FP_s2026, FL_T/FP_s2027, FL_T/FA_1024_s2026 (STOPPED_REALLOCATED, 06N N4)",
     "runs_ds3/FL/ (pre-S4 ladder; never passed to the index)", "WARM_PREVIEW", "S7S8_T", "S7S8", "SMOKE_R6", "LADDER_S1a",
     "S_CAL* dirs", "the 06O UNSEEN_VAL preview dirs (REEVAL_A40/*_UNSEEN_VAL_*)", "DEV smoke / dry / SEL dirs (index rules)"],
 "n33_mapping": "FL_T/N33_<ARM>_s<S> IS the registered cold run of ARM (FP, PF, FA_Q8, FA_1024, DP8, DP1); entry tag cold_rerun 06N N3.3",
 "inventory": inv, "launch_code_identity": code_tree,
 "after_freeze": "nothing in tools/, reeval.py or the contrasts file changes; a refusal in E means a NEW tree and a NEW freeze",
}
fd = os.open(E["CAND"], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o444)
with os.fdopen(fd, "w", encoding="utf-8") as f: json.dump(doc, f, indent=1, sort_keys=True, ensure_ascii=False)
print("FREEZE_CANDIDATE_WRITTEN", sha(E["CAND"]))
PY
date -u +%FT%TZ > $OK/D_$ANA_TAG.ok; step "QUEUE_DONE D rc=0 candidate $(sha $CAND | cut -c1-16)"
